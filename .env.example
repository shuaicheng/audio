# 复制为 .env 后只在服务器上填写。不要提交 .env，不要把上游密钥写进前端。

# live：连接下方上游适配器。mock：本地离线演示，不是真实模型结果。
APP_MODE=live
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

# 浏览器来源白名单，逗号分隔。星号表示不限制（仅建议在受信网络）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 本服务自己的 WebSocket 门禁。留空则不校验。这不是上游密钥。
APP_AUTH_TOKEN=

# realtime | qwen_streaming | degraded_file | auto
# auto 只会走 realtime，失败时明确报错，不会偷偷改成整段文件上传。
ASR_PROVIDER=realtime
ASR_REALTIME_URL=ws://120.48.180.39:10002/v1/realtime
ASR_FILE_URL=http://120.48.180.39:10002/v1/audio/transcriptions
ASR_MODEL=Qwen3-ASR-1.7B
ASR_SAMPLE_RATE=16000
ASR_TIMEOUT_SEC=20
ASR_HANDSHAKE_TIMEOUT_SEC=5
ASR_ERROR_PROBE_SEC=0.4
# 上游识别服务的可选鉴权，仅服务端。不要填到 VITE_ 变量。
ASR_AUTHORIZATION=
ASR_COOKIE=

# 官方 qwen-asr 流式 worker。解释器应来自单独虚拟环境，并已安装 requirements-qwen-asr.txt。
QWEN_ASR_WORKER_PYTHON=
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_GPU_MEMORY_UTILIZATION=0.8
QWEN_ASR_MAX_NEW_TOKENS=32
QWEN_ASR_UNFIXED_CHUNK_NUM=2
QWEN_ASR_UNFIXED_TOKEN_NUM=5
QWEN_ASR_CHUNK_SIZE_SEC=2.0
QWEN_ASR_LANGUAGE=
QWEN_ASR_CONTEXT=
QWEN_ASR_LOAD_TIMEOUT_SEC=600

# 仅当 ASR_PROVIDER=degraded_file 时生效。0 表示只在说完后上传一次整段，仍然不是真流式。
# 大于 0 会按间隔重传“越来越长的整段”，事件里会标明 cumulative_file_reupload。
ASR_DEGRADED_CHUNK_SEC=0

LLM_URL=http://120.48.180.39:20002/v1/chat/completions
LLM_MODEL=Qwen3.8-Flash
# 必填才会向语言模型发请求。空字符串是占位，仓库里没有真实密钥。
AUDIO_LLM_API_KEY=
LLM_TIMEOUT_SEC=90
LLM_FIRST_TOKEN_TIMEOUT_SEC=25
LLM_TEMPERATURE=0.7

TTS_URL=http://120.48.180.39:10001/v1/audio/speech
TTS_MODEL=/models/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_VOICE=vivian
TTS_LANGUAGE=Chinese
# 不要假设与 ASR 的 16000 相同。响应头 X-Sample-Rate / X-Audio-Sample-Rate 优先。
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT_SEC=60
TTS_AUTHORIZATION=
TTS_COOKIE=

SENTENCE_MAX_CHARS=42
SENTENCE_MIN_CHARS=6
SENTENCE_FLUSH_TIMEOUT_SEC=0.7

MAX_AUDIO_PENDING_CHUNKS=128
MAX_UTTERANCE_BYTES=3200000
PLAYBACK_MAX_INFLIGHT_BYTES=96000
PLAYBACK_STALL_TIMEOUT_SEC=15
OUTGOING_QUEUE_CHUNKS=32
HISTORY_MAX_TURNS=16

# 离线演示每个字的间隔秒数。live 模式不使用。
MOCK_TOKEN_DELAY_SEC=0.02
